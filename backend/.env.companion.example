# Copy these values into backend/.env; do not commit the real values.
# Generate a high-entropy access token with: openssl rand -hex 32
COMPANION_ACCESS_TOKEN=
COMPANION_MODEL_KEY=
COMPANION_MODEL_URL=
COMPANION_MODEL=
COMPANION_PORT=5050

# Optional semantic retrieval; set all three on the server, never in Expo.
COMPANION_EMBEDDING_URL=
COMPANION_EMBEDDING_MODEL=
COMPANION_EMBEDDING_KEY=
